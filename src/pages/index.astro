---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Dial from "../components/Dial.astro";
import Hero from "../components/Hero.astro";
import Ticker from "../components/Ticker.astro";
import Concepto from "../components/Concepto.astro";
import Pilares from "../components/Pilares.astro";
import Modelo from "../components/Modelo.astro";
import Accion from "../components/Accion.astro";
import Noticias from "../components/Noticias.astro";
import Compromiso from "../components/Compromiso.astro";
import Radios from "../components/Radios.astro";
import Mesa from "../components/Mesa.astro";
import Alianzas from "../components/Alianzas.astro";
import Join from "../components/Join.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Red de Radios Universitarias de México — Resonamos ideas, amplificamos el futuro"
  description="La RRUM reúne a 41 radios afiliadas. Cuando una idea se comparte no se replica: se amplifica.">
  <Header />
  <Dial />
  <main>
    <Hero />
    <Ticker />
    <Concepto />
    <Pilares />
    <Modelo />
    <Accion />
    <Noticias />
    <Compromiso />
    <Radios />
    <Mesa />
    <Alianzas />
    <Join />
  </main>
  <Footer />
</Layout>
