---
/* Footer */
---

<footer class="border-t border-ink-line bg-ink-0 py-14">
  <div class="container-rrum grid items-start gap-12 max-md:grid-cols-1 md:grid-cols-[1.4fr_.8fr_1fr]">
    <div>
      <img src="/img/logo-rrum.png" alt="RRUM" class="mb-4 h-10 w-auto" width="140" height="46" />
      <p class="max-w-[340px] text-[15px] text-cool-1">Gracias por resonar con nosotros. Juntos, amplificamos el futuro.</p>
    </div>
    <div class="flex flex-col gap-6">
      <a
        class="inline-flex w-max items-center gap-2.5 text-[13.5px] text-cool-1 transition hover:text-orange"
        href="https://rrum.mx/estatutos-de-la-rrum/"
        target="_blank"
        rel="noopener"
        title="Estatutos de la RRUM"
      >
        <i class="fa-solid fa-gavel"></i>
        Estatutos de la RRUM
      </a>
      <a
        class="inline-flex w-max items-center gap-2.5 text-[13.5px] text-cool-1 transition hover:text-orange"
        href="https://rrum.mx/category/comunicados/"
        target="_blank"
        rel="noopener"
        title="Comunicados de la Red de Radios Universitarias de México"
      >
        <i class="fa-solid fa-bullhorn"></i>
        Comunicados de la Red de Radios Universitarias de México
      </a>

      <div class="flex flex-wrap gap-3">
        <a
          class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-[20px] transition hover:-translate-y-0.5 hover:shadow-[0_10px_24px_rgba(0,0,0,.35)]"
          href="https://www.facebook.com/RRUMexico/"
          target="_blank"
          rel="noopener"
          title="Facebook · RRUM"
        >
          <i class="fa-brands fa-facebook" style="color:#1877f2"></i>
        </a>
        <a
          class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-[20px] transition hover:-translate-y-0.5 hover:shadow-[0_10px_24px_rgba(0,0,0,.35)]"
          href="https://www.instagram.com/rrumexico/"
          target="_blank"
          rel="noopener"
          title="Instagram · RRUM"
        >
          <i class="fa-brands fa-instagram" style="background:linear-gradient(45deg,#f9ce34 10%,#ee2a7b 55%,#6228d7 90%);-webkit-background-clip:text;background-clip:text;color:transparent"></i>
        </a>
        <a
          class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-[20px] transition hover:-translate-y-0.5 hover:shadow-[0_10px_24px_rgba(0,0,0,.35)]"
          href="https://www.youtube.com/@RRUMex"
          target="_blank"
          rel="noopener"
          title="YouTube · RRUM"
        >
          <i class="fa-brands fa-youtube" style="color:#ff0000"></i>
        </a>
        <a
          class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-[20px] transition hover:-translate-y-0.5 hover:shadow-[0_10px_24px_rgba(0,0,0,.35)]"
          href="https://x.com/rrumexico"
          target="_blank"
          rel="noopener"
          title="X · RRUM"
        >
          <i class="fa-brands fa-x-twitter" style="color:#000000"></i>
        </a>
      </div>
    </div>
    <div class="text-[13.5px] text-cool-1">
      <p class="mb-2">Red de Radios Universitarias de México</p>
      <p class="opacity-70">Frecuencia transmitida desde el corazón universitario de México · © 2026</p>
    </div>
  </div>
</footer>
